# Server Configuration
NODE_ENV=development # Application environment: development, production, test
PORT=4000 # Server port number
CLIENT_URL=http://localhost:3000 # Frontend address (your Vercel URL in production). Allowed to call the API directly: chat stream and live metrics
TRUST_PROXY=0 # Number of proxies in front of the API (2 on Render behind a Vercel proxy). Fixes per-visitor rate limiting
COOKIE_SAMESITE=lax # Keep lax: the Vercel proxy makes the cookie first-party. Use none only if the browser talks to the API directly across sites (needs HTTPS)

# Neon Database URL
DATABASE_URL="postgresql://neondb_owner:xxxxx@xxxxxx/neondb?sslmode=require&channel_binding=require" # Complete PostgreSQL connection string for Neon database

# JWT Configuration
JWT_SECRET=xxxxxxxxxxx # Secret key for signing JWT access tokens
JWT_EXPIRES_IN=15m # Access token lifetime. Short on purpose: the refresh cookie quietly renews it
JWT_REFRESH_SECRET=xxxxxxxxxxxxxx # No longer used (refresh tokens are random and stored hashed); still required at startup
JWT_REFRESH_EXPIRES_IN=30d # No longer used. See SESSION_DAYS and SESSION_REMEMBER_DAYS
SESSION_DAYS=1 # How long a sign-in lasts without Remember me
SESSION_REMEMBER_DAYS=30 # How long a sign-in lasts with Remember me

# OPENAI API
OPENAI_API_KEY= # Optional shared fallback. Users can save their own key in Profile instead

# Google Gemini API
GEMINI_API_KEY= # Optional shared fallback. Users can save their own key in Profile instead

# DeepSeek API
DEEPSEEK_API_KEY= # Optional shared fallback. Users can save their own key in Profile instead

# Email Configuration
SMTP_HOST=smtp.gmail.com # SMTP server hostname
SMTP_PORT=587 # SMTP server port (587 for TLS, 465 for SSL)
SMTP_USER=example@gmail.com # Email address for sending notifications
SMTP_PASSWORD=fhgnxxxxxxxxx # Email password or app-specific password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # Time window in milliseconds for rate limiting (15 minutes)
RATE_LIMIT_MAX_REQUESTS=100 # Maximum number of requests per window

# Security
BCRYPT_ROUNDS=10 # Number of rounds for bcrypt password hashing (higher = more secure but slower)
EMAIL_FROM="Nebula <example@gmail.com>" # Sender shown on verification and reset emails (use the same Gmail address as SMTP_USER)

# Encrypts the API keys users save in Profile (required to save keys)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=
